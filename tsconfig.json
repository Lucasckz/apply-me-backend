// tsconfig.json
{
  "compilerOptions": {
    /* Basic Options */
    "lib": ["es2020"],
    "module": "CommonJS",
    "target": "ES2022",              
    "rootDir": "src",                  
    "outDir": "dist",                      
    "strict": true,                         
    "esModuleInterop": true,                
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,    
    "preserveConstEnums": true,
    "moduleResolution": "node",
    "sourceMap": true,
    "types": ["node"],          
    /* Additional Options */        
    "noImplicitAny": true,                  
    "noUnusedLocals": true,                
    "noUnusedParameters": true               
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
