// tsconfig.json
{
  "compilerOptions": {
    /* Basic Options */
    "target": "ES2020",             
    "module": "commonjs",            
    "rootDir": "src",                  
    "outDir": "dist",                      
    "strict": true,                         
    "esModuleInterop": true,                
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,                 

    /* Additional Options */
    "resolveJsonModule": true,            
    "noImplicitAny": true,                  
    "noUnusedLocals": true,                
    "noUnusedParameters": true               
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
